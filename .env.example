# OpenRouter API Key for AI Workforce models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default Model identifier (e.g., qwen/qwen-2.5-coder-32b-instruct)
DEFAULT_MODEL=qwen/qwen-2.5-coder-32b-instruct

# Canonical root path for workspace guardrails and operations (defaults to current directory if unset)
WORKSPACE_ROOT=.

# Execution limits
MAX_STEPS=15
TIMEOUT_SECONDS=300
